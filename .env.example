# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_DB=parley
POSTGRES_USER=parley
POSTGRES_PASSWORD=change-me

# The app's address for the database: driver://user:password@host:port/database
# Use the same user, password and database name as above.
DATABASE_URL=postgresql+psycopg://parley:change-me@localhost:5432/parley

# A separate database only for tests (pytest), so they never touch your data.
# Same as DATABASE_URL, but the name must end in _test. Create it once with:
# docker compose exec db createdb -U parley parley_test
TEST_DATABASE_URL=postgresql+psycopg://parley:change-me@localhost:5432/parley_test

# The app's address for Redis (D22): redis://host:port/database-number.
# Redis has numbered databases, 0 to 15, inside one server.
# 127.0.0.1, not localhost (on Windows localhost is slow to fail when Redis is down, D22).
REDIS_URL=redis://127.0.0.1:6379/0

# Redis database 15 is only for tests, which wipe it after each test.
# The tests refuse to run on any other number.
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# RabbitMQ's user and password (D25). Docker makes this user on first start.
RABBITMQ_USER=parley
RABBITMQ_PASSWORD=change-me

# The app's address for RabbitMQ: amqp://user:password@host:port/vhost.
# A vhost is a separate set of queues inside one RabbitMQ; %2F means "/",
# the default one. 127.0.0.1, not localhost (on Windows localhost is slow
# to fail when the server is down, D22).
RABBITMQ_URL=amqp://parley:change-me@127.0.0.1:5672/%2F

# A separate vhost only for tests, which empty its queues. The tests refuse
# any other. Create it once with:
# docker compose exec rabbitmq rabbitmqctl add_vhost parley_test
# docker compose exec rabbitmq rabbitmqctl set_permissions -p parley_test parley ".*" ".*" ".*"
TEST_RABBITMQ_URL=amqp://parley:change-me@127.0.0.1:5672/parley_test

# Which notifier the worker uses (D26): log (one log line, the default, for
# tests and CI) or webpush (real browser notifications).
NOTIFIER=webpush

# The VAPID key pair: proves a push came from Parley (D26). The public key goes
# to the browser; the private one never leaves .env. Make both once with (in
# backend, with the venv on):
# python -c "from py_vapid import Vapid; from py_vapid.utils import b64urlencode; from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat; v = Vapid(); v.generate_keys(); print('VAPID_PRIVATE_KEY=' + b64urlencode(v.private_key.private_numbers().private_value.to_bytes(32, 'big'))); print('VAPID_PUBLIC_KEY=' + b64urlencode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)))"
VAPID_PRIVATE_KEY=change-me
VAPID_PUBLIC_KEY=change-me
# Who the push services can contact if our pushes cause trouble: a mailto: address.
VAPID_SUBJECT=mailto:you@example.com

# Signs access tokens. Make a strong one with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me

# Grafana's admin password (D32): log in at http://localhost:3000 as admin.
# Grafana refuses to start without one.
GRAFANA_ADMIN_PASSWORD=change-me
