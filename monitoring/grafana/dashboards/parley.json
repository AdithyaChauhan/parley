{
  "uid": "parley",
  "title": "Parley",
  "description": "What Parley is doing right now (D32). This file is the truth: change it here, not in Grafana.",
  "tags": ["parley"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests/s by copy",
      "description": "HTTP requests per second on each backend copy. A stopped copy drops to 0 (its 'up' turns 0). The live line isn't HTTP, so it's in 'Open live lines'.",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (copy) (rate(http_requests_total{job=\"backend\"}[$__rate_interval])) or sum by (copy) (up{job=\"backend\"} == 0)",
          "legendFormat": "{{copy}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "How long HTTP requests take, both copies together. p95: 95% of requests were faster than this line.",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx errors and 429s per second",
      "description": "5xx (red): the backend failed. 429: a spam limit refused the request, by rule (D24).",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"backend\", status=~\"5..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "expr": "sum by (rule) (rate(rate_limited_total{job=\"backend\"}[$__rate_interval]))",
          "legendFormat": "429 {{rule}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Open live lines per copy",
      "description": "Open WebSockets (one per tab) on each copy. Stop backend_a: its line drops to 0 and B's goes up as the apps reconnect.",
      "gridPos": { "x": 0, "y": 7, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (copy) (live_lines_open{job=\"backend\"}) or sum by (copy) (up{job=\"backend\"} == 0)",
          "legendFormat": "{{copy}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Messages per minute",
      "description": "New messages saved, both copies together. A resend of the same message isn't counted twice.",
      "gridPos": { "x": 8, "y": 7, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "suffix: /min", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(messages_sent_total{job=\"backend\"}[$__rate_interval])) * 60",
          "legendFormat": "messages"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Notification outcomes per minute",
      "description": "How each try of a notification job ended (D25). Green: sent. Blue/purple: skipped (no need to notify). Orange 'failed': a retry was booked. Red 'parked': it's in notify.failed.",
      "gridPos": { "x": 16, "y": 7, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "suffix: /min", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "sent" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "skip: already read" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "skip: already notified" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "light-blue" } }] },
          { "matcher": { "id": "byName", "options": "skip: no devices" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }] },
          { "matcher": { "id": "byName", "options": "skip: message or member gone" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "light-purple" } }] },
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "parked" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(notify_jobs_total{job=\"worker\"}[$__rate_interval])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Jobs waiting in RabbitMQ. notify should stay near 0 (the worker keeps up). notify.failed holds parked jobs until replay.",
      "gridPos": { "x": 0, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rabbitmq_detailed_queue_messages{vhost=\"/\", queue=~\"notify|notify.failed\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Postgres connections",
      "description": "Open connections to PostgreSQL, against its limit.",
      "gridPos": { "x": 6, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_database_numbackends)",
          "legendFormat": "open"
        },
        {
          "refId": "B",
          "expr": "max(pg_settings_max_connections)",
          "legendFormat": "limit"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Redis memory",
      "description": "Memory Redis uses for presence, tickets, limits and notes (D22).",
      "gridPos": { "x": 12, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Redis commands/s",
      "description": "Every Redis command per second: pings, limits, tickets, pub/sub.",
      "gridPos": { "x": 18, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_commands_processed_total[$__rate_interval])",
          "legendFormat": "commands"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU per container",
      "description": "CPU each Parley container uses. 100% = one full CPU core.",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"parley\"}[$__rate_interval]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Memory per container",
      "description": "Memory each Parley container uses (working set: what it can't give back).",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=\"parley\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ]
    }
  ]
}
